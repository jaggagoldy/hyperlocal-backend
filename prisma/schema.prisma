generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}



model User {
  id                   String    @id @default(uuid())
  phoneNumber          String?   @unique
  email                String?   @unique
  passwordHash         String?
  passwordResetOtp     String?
  passwordResetExpires DateTime?
  googleId             String?   @unique
  name                 String?
  role                 String    @default("customer") // kept ONLY for 'admin' usage
  isBanned             Boolean   @default(false)

  // === DUAL-PROFILE FLAGS ===
  hasCustomerProfile Boolean @default(false)
  hasVendorProfile   Boolean @default(false)
  isPhoneVerified    Boolean @default(false)

  // Customer-specific profile fields (legacy columns kept for data migration)
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  customerName        String?
  customerGender      String?
  customerAddress     String?
  customerDateOfBirth DateTime?

  businessProfiles BusinessProfile[]
  feedbacks        Feedback[]
  reviews          Review[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model OtpSession {
  id          String   @id @default(uuid())
  phoneNumber String
  otpHash     String
  hashedToken String   @unique
  attempts    Int      @default(0)
  isVerified  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model City {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  state            String            @default("Haryana")
  district         String?
  businessProfiles BusinessProfile[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([state])
  @@index([state, district])
}

model Category {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  parentId         String?
  parent           Category?          @relation("CategoryToCategory", fields: [parentId], references: [id])
  subcategories    Category[]         @relation("CategoryToCategory")
  businessProfiles BusinessCategory[]
  catalogItems     CatalogItem[]
  archetype        String             @default("SERVICE")
  icon             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([parentId])
}

model BusinessProfile {
  id                 String               @id @default(uuid())
  userId             String?              // nullable: unclaimed imported stubs have no owner yet (Phase F)
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  slug               String               @unique
  registrationNumber String               @unique
  businessType       String               @default("HOME_ESSENTIALS")
  isStreetVendor     Boolean              @default(false)
  isOnline           Boolean              @default(true)
  metaData           Json?                // Stores flexible configs like cab vehicle type, salon rules
  moduleConfig       Json?                // Stores capability blueprints: commerce, scheduling, leadGen, estimation
  landmark           String?
  operatingHours     Json?
  localityName       String
  chowkLandmark      String?
  pincode            String
  status             String               @default("available") // available, busy, closed, emergency, suspended, banned
  bookingMode        String?              // ORDER | DIRECT_BOOK | REQUEST_TO_BOOK | CART (per vertical)
  listingTier        String?              // DIRECTORY | BOOKABLE | COMMERCE (Phase F tier; public label / CTA driver)
  isClaimed          Boolean              @default(true)  // false for unclaimed imported stubs awaiting claim
  source             String?              @default("self") // self | osm | places — provenance, source-agnostic
  externalId         String?              // upstream id (e.g. OSM node/way) for import dedup; null when self-onboarded
  membershipTier     String               @default("Free") // Pro, Starter, Free
  rating             Float                @default(0.0)
  isFeatured         Boolean              @default(false)
  cityId             String
  city               City                 @relation(fields: [cityId], references: [id])
  categories         BusinessCategory[]
  subscriptions      BusinessSubscription[]
  analytics          LeadAnalytic[]
  media              BusinessMedia[]
  catalogItems       CatalogItem[]
  orders             OrderEnquiry[]
  reviews            Review[]
  customServiceType  String?
  requestedCategory  String?
  timeAvailability   String?
  workingDays        String?
  locationType       String? // Freelancer, Shop
  idType             String? // Aadhar, PAN, DL
  idNumber           String?
  idVerified         Boolean              @default(false)
  verificationStatus       VerificationStatus @default(NOT_SUBMITTED)
  verificationSubmittedAt  DateTime?
  verificationReviewedAt   DateTime?
  verificationRejectionReason String?
  latitude           Float?
  longitude          Float?
  themeFlavor        String               @default("trust-utility")
  connectionMode     String               @default("REQUIRE_APPROVAL")
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([cityId])
  @@index([status])
  @@index([verificationStatus])
  @@index([pincode])
  @@index([slug])
  @@index([membershipTier, status, rating(sort: Desc)])
  @@index([userId])
  @@index([listingTier])
  @@index([source, externalId])
}

model BusinessCategory {
  businessProfileId String
  categoryId        String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessProfileId, categoryId])
  @@index([categoryId])
}

model BusinessSubscription {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  tier              String // Pro, Starter, Free
  expiresAt         DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
}

model LeadAnalytic {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  type              String // profile_view, call_click, whatsapp_click
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([businessProfileId, type])
  @@index([createdAt])
}

model SearchAnalytic {
  id           String   @id @default(uuid())
  citySlug     String
  categorySlug String
  query        String?
  resultsCount Int
  createdAt    DateTime @default(now())

  @@index([resultsCount, createdAt])
}

model BusinessMedia {
  id                String          @id @default(uuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  type              String // profile_image, gallery, verification_doc
  secureUrl         String
  publicId          String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId, type])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // ContactUs, Report
  message   String
  status    String   @default("pending") // pending, resolved
  // Set when type='Report' and the report is against a specific review
  // (Sprint 2 Batch 5) — nullable so the model still serves generic
  // ContactUs/Report feedback with no target entity, as it always has.
  reviewId  String?
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([reviewId])
}

model CatalogItem {
  id                String          @id @default(uuid())
  businessProfileId String
  categoryId        String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id])
  title             String
  description       String?
  price             Decimal?
  unit              String?
  mediaUrl          String?
  variants          Json?           // Legacy: keep or remove. User said "Add metaData Json?"
  metaData          Json?           // Used for flexible fields (veg/nonveg, duration, etc.)
  isActive          Boolean         @default(true)
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orderItems        OrderItem[]

  @@index([businessProfileId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isAvailable])
}

model Review {
  id                String          @id @default(uuid())
  businessProfileId String
  customerId        String
  orderId           String?
  rating            Int
  comment           String?
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  isHidden          Boolean         @default(false)
  hiddenReason      String?
  hiddenAt          DateTime?
  reports           Feedback[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessProfileId])
  @@index([customerId])
  @@index([isHidden])
}



model OrderEnquiry {
  id                String          @id @default(uuid())
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  customerId        String?
  orderType         String          @default("SERVICE_BOOKING")
  customerName      String
  customerPhone     String
  serviceLocation   String?
  totalValue        Decimal
  status            OrderStatus     @default(PENDING)
  rejectionReason   String?
  scheduledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]

  @@index([businessProfileId, status])
  @@index([customerId])
}

model OrderItem {
  id                 String       @id @default(uuid())
  orderId            String
  order              OrderEnquiry @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId      String
  catalogItem        CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quantity           Int
  priceAtTimeOfOrder Decimal
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orderId])
  @@index([catalogItemId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   // JSON string or comma-separated list
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// Sprint 2 Batch 4. Deliberately has no foreign keys: an audit trail must
// survive the actor's account or the target entity being deleted later, so
// actorId/entityId are loose string references, not relations.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
