# NearByBazar — Environment Variables (example)
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must NEVER
# be committed. This file documents every variable the app reads (names only —
# no secrets). Validation lives in src/config/env.js (zod schema).
#
# ── Required (boot fails without these) ──────────────────────────────────────
DATABASE_URL=            # Postgres connection string. LOCAL for dev; prod = Neon.
JWT_SECRET=              # Secret for signing auth tokens. Use a long random value.

# ── Core (have safe defaults; override per environment) ──────────────────────
NODE_ENV=development     # development | production | test
PORT=3000
LOG_LEVEL=               # optional pino level override (default: debug in dev, info in prod)

# ── Feature integrations (OPTIONAL — missing keys disable the feature, never crash boot) ─
# Media upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase (admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Launch configuration (have defaults) ─────────────────────────────────────
# Comma-separated live verticals; others render as "Coming Soon".
ENABLED_VERTICALS=FOOD_BEVERAGE,GROCERY,RETAIL,SALON_BEAUTY,HEALTH_MEDICAL,HOME_ESSENTIALS,PROFESSIONAL_SERVICES,EDUCATION,FITNESS,AUTOMOTIVE,REAL_ESTATE,HOTELS,EVENTS,PERSONAL_SERVICES,TRAVEL,FINANCIAL_SERVICES
DEFAULT_STATE=Haryana

# Frontend origin allowed by CORS (Next.js app). *.vercel.app previews are auto-allowed.
FRONTEND_URL=
